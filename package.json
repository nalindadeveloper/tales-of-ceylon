{
  "name": "island-journal",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive 3D Sri Lanka island experience built with Three.js, GSAP and real elevation data.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "geo:fetch": "node scripts/geo/fetch-geodata.mjs",
    "geo:build": "node scripts/geo/build-terrain.mjs && node scripts/geo/build-shore-field.mjs",
    "geo": "npm run geo:fetch && npm run geo:build",
    "assets:audio": "node scripts/assets/generate-ambient-audio.mjs",
    "assets:images": "node scripts/assets/fetch-images.mjs",
    "geo:shore": "node scripts/geo/build-shore-field.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lenis": "^1.3.27",
    "lucide": "^1.60.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "cdt2d": "^1.0.0",
    "lamejs": "^1.2.1",
    "pngjs": "^7.0.0",
    "sass": "^1.105.2",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  }
}
